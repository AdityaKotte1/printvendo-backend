{
	email admin@printvendo.com

	# Let's Encrypt only. Caddy's default is to fall back to ZeroSSL when LE
	# fails, and ZeroSSL's ACME endpoint is unreachable from this VPS -- every
	# retry then spent ~150s timing out before coming back round to the issuer
	# that can actually work. Pinning it also stops Caddy dropping to LE's
	# staging CA after repeated failures, which issues an untrusted certificate.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# One site. The three consoles are static builds hosted elsewhere and reach
# this over CORS -- which is why CORS_ORIGINS in .env has to name every one of
# their real deployed origins, Vercel and Netlify preview URLs included if you
# want those to work.
api.printvendo.com {
	encode zstd gzip

	# Students upload PDFs through here. Comfortably above the largest document
	# worth printing, comfortably below a denial of service.
	request_body {
		max_size 80MB
	}

	reverse_proxy api:8000
}
