# Copy to deploy/.env on the VPS and fill in every <...>.
# chmod 600 it. NEVER commit it.
#
# Marked "CARRY" below: take the value from the old VPS's
# /opt/printit/cloud-backend/deploy/.env . Everything else is new.

# ── Postgres (compose reads these for the db container) ─────────────────────
POSTGRES_USER=printvendo
POSTGRES_PASSWORD=            # generate: openssl rand -base64 32
POSTGRES_DB=printvendo

ENV=prod
DATABASE_URL=postgresql+psycopg://printvendo:SAME_PASSWORD_AS_ABOVE@db:5432/printvendo
REDIS_URL=redis://redis:6379/0

# ── Secrets that are NEW, not carried ──────────────────────────────────────
# The old JWT secret is deliberately not reused: no sessions are being carried
# over, so there is nothing for it to keep valid.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Decrypts every owner's Razorpay key secret. Keep a copy somewhere your
# backups are not -- losing it means every owner re-enters keys by hand.
SECRETS_ENCRYPTION_KEY=

# ── Razorpay ───────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=              # CARRY
RAZORPAY_KEY_SECRET=          # CARRY
RAZORPAY_WEBHOOK_SECRET=      # CARRY -- the app refuses to boot in prod without it

# ── Google sign-in ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=             # CARRY

# ── Email ──────────────────────────────────────────────────────────────────
BREVO_API_KEY=                # CARRY
MAIL_FROM_EMAIL=hello@printvendo.com
MAIL_FROM_NAME=Printvendo

# ── Where the apps are ─────────────────────────────────────────────────────
# Every frontend origin, spelled out. A wildcard refuses to boot in prod.
# These are the Vercel/Netlify domains, so put the REAL deployed hostnames here.
CORS_ORIGINS=https://printvendo.com,https://owner.printvendo.com,https://admin.printvendo.com
PUBLIC_BASE_URL=https://api.printvendo.com
APP_BASE_URL=https://printvendo.com

# Behind Caddy every request arrives from Caddy. Without this the whole
# internet shares one rate-limit bucket.
TRUST_PROXY_HEADERS=true

# ── Files and Ghostscript ──────────────────────────────────────────────────
# Must match the volume mount in docker-compose.yml.
STORAGE_ROOT=/var/lib/printvendo/storage
GHOSTSCRIPT_PATH=/usr/bin/gs

# ── What goes on an owner's subscription invoice ────────────────────────────
INVOICE_ISSUER_NAME=Printvendo
INVOICE_ISSUER_LINES=Printvendo Technologies|<your registered address>
INVOICE_ISSUER_EMAIL=billing@printvendo.com
