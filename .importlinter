[importlinter]
root_package = app

[importlinter:contract:core-is-independent]
name = core must not depend on modules or api
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.modules
    app.api

[importlinter:contract:modules-do-not-depend-on-api]
name = modules must not depend on the api layer
type = forbidden
source_modules =
    app.modules
forbidden_modules =
    app.api

[importlinter:contract:api-does-not-touch-orm-models]
name = the api layer goes through services, never through the ORM module
type = forbidden
source_modules =
    app.api
forbidden_modules =
    app.modules.identity.models
    app.modules.kiosks.models
    app.modules.payments.models
    app.modules.billing.models
    app.modules.printing.models
    app.modules.wallet.models
    app.modules.orders.models
# Only DIRECT imports are a violation. The api layer calls services, and those
# services obviously use their own models -- forbidding that transitively would
# ban the api from calling anything at all. What must not happen is api code
# reaching for the ORM module itself; entity types come from the package's
# public surface (`from app.modules.identity import User`).
allow_indirect_imports = True

[importlinter:contract:modules-do-not-reach-into-each-others-orm]
name = a module may use another's public surface, never its tables
type = forbidden
source_modules =
    app.modules.kiosks
forbidden_modules =
    app.modules.identity.models
allow_indirect_imports = True

[importlinter:contract:modules-are-independent]
name = bounded contexts do not reach into each other
type = independence
# An independence contract over ONE module is vacuously true: there are no pairs
# to check, so it passed while proving nothing. It listed only identity until
# printing landed. Both are leaf contexts -- neither imports another module --
# so the pair is a real assertion. kiosks cannot join: it legitimately imports
# identity to resolve a User, which the contract below bounds instead.
modules =
    app.modules.identity
    app.modules.printing

[importlinter:contract:printing-is-self-contained]
name = printing depends on no other bounded context
type = forbidden
# Printing needs paper deducted, and paper belongs to kiosks. Rather than import
# it, printing declares a PaperLedger protocol that the api layer implements
# over kiosks.paper. This contract is what stops that seam being "simplified"
# into a direct import later, which would tie the print path to the tray.
source_modules =
    app.modules.printing
forbidden_modules =
    app.modules.kiosks
    app.modules.payments
    app.modules.billing

[importlinter:contract:orders-uses-surfaces-not-tables]
name = orders spans contexts through their surfaces, never their tables
type = forbidden
# Orders is the aggregate, so unlike printing it legitimately depends on kiosks,
# payments and printing. What it must not do is write their rows: the old
# backend's three core tables were created and mutated from every router that
# felt like it, which is how their meanings drifted apart. Orders asks printing
# to enqueue; it does not construct a PrintTask.
source_modules =
    app.modules.orders
forbidden_modules =
    app.modules.identity.models
    app.modules.kiosks.models
    app.modules.payments.models
    app.modules.billing.models
    app.modules.wallet.models
allow_indirect_imports = True

[importlinter:contract:payments-does-not-know-what-it-paid-for]
name = payments does not depend on orders
type = forbidden
# A refund may close an order, and orders imports payments -- so a direct import
# here would be a cycle, and the shortest way to write one is to "just" call the
# orders service from refunds.py. The transition comes back through the
# RefundSink protocol instead, wired at the composition root. Until this
# contract existed the rule was a sentence in a module docstring, which is the
# shape of every defect in the legacy audit: a rule enforced in one place and
# not another.
source_modules =
    app.modules.payments
forbidden_modules =
    app.modules.orders

[importlinter:contract:ops-records-about-things-it-does-not-know]
name = ops depends on no other bounded context
type = forbidden
# Ops records that a kiosk went offline or that an owner's keys changed, and it
# does so by public id and type -- strings. Importing the modules it records
# about would make every context depend on ops the moment ops depended on them,
# and "add an import to audit this" is how an audit helper ends up covering 16%
# of the routes that should call it. The dependency runs one way: modules and
# the api layer call ops; ops calls nobody.
source_modules =
    app.modules.ops
forbidden_modules =
    app.modules.identity
    app.modules.kiosks
    app.modules.payments
    app.modules.billing
    app.modules.printing
    app.modules.orders
    app.modules.wallet

[importlinter:contract:wallet-is-self-contained]
name = the wallet depends on no other bounded context
type = forbidden
# A balance is a balance. It does not know what a kiosk is, what an order costs,
# or whose Razorpay collects -- those are the orders module's business, and it
# calls debit(). Keeping the dependency one-way is what stops the wallet growing
# a second opinion about where money may be spent, which is the shape of the
# leak this rewrite exists to close.
source_modules =
    app.modules.wallet
forbidden_modules =
    app.modules.kiosks
    app.modules.payments
    app.modules.billing
    app.modules.printing
    app.modules.orders

[importlinter:contract:jobs-go-through-services]
name = jobs and the command line go through services, never through the ORM module
type = forbidden
# The same rule the api layer has, for the same reason: a sweep is a composition
# root, so it may know about several contexts at once, but it must reach them
# through their surfaces. A job that wrote another module's rows would be a
# second implementation of that module's invariants, running unattended.
source_modules =
    app.jobs
    app.cli
    app.provisioning
    app.refunding
forbidden_modules =
    app.modules.identity.models
    app.modules.kiosks.models
    app.modules.payments.models
    app.modules.billing.models
    app.modules.printing.models
    app.modules.wallet.models
    app.modules.orders.models
allow_indirect_imports = True

[importlinter:contract:layers]
name = the roots sit above use cases sit above modules sit above core
type = layers
# `app.jobs | app.api` is one layer holding two *independent* siblings -- the
# pipe is what makes them independent; a colon would let them import each other
# and was verified to allow exactly that. Both are composition roots, and
# neither may import the other: a route that wants a sweep run now calls the
# same service the job calls.
layers =
    app.jobs | app.api | app.cli
    app.provisioning | app.refunding
    app.modules
    app.core
